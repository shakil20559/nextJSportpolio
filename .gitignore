# Dependencies
node_modules/
/client/node_modules/
/server/node_modules/

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/server/.pnp
/server/.pnp.*
/server/.yarn/*
!/server/.yarn/patches
!/server/.yarn/plugins
!/server/.yarn/releases
!/server/.yarn/versions

# Testing
/client/coverage/
/server/coverage/

# Next.js
/client/.next/
/server/.next/   # Add this if server uses Next.js
/client/out/

# Production
/client/build/
/server/build/
/server/dist/

# Environment variables
.env*
!/client/.env.example
!/server/.env.example
!.env.example

# Vercel
/client/.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Certificates / private keys
*.pem
*.key

# TypeScript
*.tsbuildinfo
/client/next-env.d.ts
/server/next-env.d.ts   # Add if server uses Next.js
