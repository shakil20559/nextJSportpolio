```gitignore
# Dependencies
/client/node_modules/
/server/node_modules/

# Yarn
/client/.pnp
/client/.pnp.*
/client/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/server/.pnp
/server/.pnp.*
/server/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/client/coverage/
/server/coverage/

# Next.js
/client/.next/
/client/out/

# Production
/client/build/
/server/build/
/server/dist/

# Environment variables
/client/.env*
/server/.env*
!.env.example
!client/.env.example
!server/.env.example

# Vercel
/client/.vercel/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Certificates / private keys
*.pem
*.key

# TypeScript
*.tsbuildinfo
/client/next-env.d.ts
```
